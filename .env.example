# ============================================
# Site Laços - Exemplo de Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores reais.
# O .env real NUNCA deve ser commitado no Git!

# Configuração do Flask
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=True

# Chave secreta (gere uma forte para produção)
SECRET_KEY=substitua-por-uma-chave-secreta-forte

# Banco de dados
# Em desenvolvimento: sqlite:///instance/site_lacos.db
# Em produção: postgresql://user:senha@host:porta/banco
DATABASE_URL=sqlite:///instance/site_lacos.db

# Configurações de e-mail
MAIL_SERVER=smtp.resend.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=resend
MAIL_PASSWORD=sua-api-key-do-resend
MAIL_DEFAULT_SENDER=contato@seudominio.com.br